[Unit]
Description=Refresh packetminder's privileged counter snapshot
# Not file:%h/…: in a *system* unit %h resolves to /root, per systemd.unit(5).
Documentation=https://github.com/pizzimenti/packetminder

[Timer]
OnBootSec=15s
OnUnitActiveSec=5s
# The daemon takes deltas between two reads, so a late refresh widens its
# measurement window rather than corrupting it. Accuracy here is not worth
# waking a sleeping CPU for.
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
