[Unit]
Description=packetminder — detect inbound traffic nothing is consuming
Documentation=file:%h/Code/packetminder/crates/packetminder/README.md
Wants=network.target
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/packetminder
Restart=on-failure
RestartSec=10s

# The daemon reads /proc/net/*, tails the journal, and shells out to
# notify-send, getent, ip and whois. It logs to stderr, which lands in the
# journal, so it never needs to write to disk at all and never needs elevated
# privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=128M

[Install]
WantedBy=default.target
